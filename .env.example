DATABASE_URL=postgres://flash:flash@localhost:5432/flash_sale
REDIS_URL=redis://localhost:6379/0
API_PORT=3000

# Integration tests use a separate database and Redis DB index.
TEST_DATABASE_URL=postgres://flash:flash@localhost:5432/flash_sale_test
TEST_REDIS_URL=redis://localhost:6379/1

# Production hardening: after the purchase gate accepts, wait until this many
# replicas have the write before replying 202. Leave at 0 for a single local Redis.
REDIS_MIN_REPLICA_ACKS=0
REDIS_REPLICA_ACK_TIMEOUT_MS=50
