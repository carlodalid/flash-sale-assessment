<mxfile host="app.diagrams.net">
  <diagram id="components" name="Components">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Flash sale – components&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;React + Vite&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product card, buy, status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k6" value="&lt;b&gt;k6&lt;/b&gt; (Docker)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;6,000-request burst&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;pnpm sale:setup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;stock, window, product&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- API -->
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt; (Express, stateless)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GET /api/sale&lt;br&gt;POST /api/purchase&lt;br&gt;GET /api/purchase/:userId&lt;br&gt;GET /healthz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Postgres -->
        <mxCell id="pg" value="&lt;b&gt;Postgres&lt;/b&gt; (durable record)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sales, purchases&lt;br&gt;UNIQUE (sale_id, user_id)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt; (AOF everysec) – the hot path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="320" height="330" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Lua purchase gate&lt;/b&gt; (one atomic step)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;window → duplicate → stock → DECR + HSET + XADD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="95" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k-sale" value="{flash-sale}:sale – hash (product, window)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k-stock" value="{flash-sale}:stock – counter" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="205" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k-purchases" value="{flash-sale}:purchases – hash userId → status" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="240" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k-stream" value="{flash-sale}:purchase-stream – stream + consumer group" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="275" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k-dlq" value="{flash-sale}:purchase-dead-letter – stream" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="310" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k-note" value="All keys share the {flash-sale} hash tag → one Cluster slot" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="740" y="350" width="280" height="20" as="geometry" />
        </mxCell>

        <!-- Worker -->
        <mxCell id="worker" value="&lt;b&gt;Worker&lt;/b&gt; (separate process)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;consumer group purchase-writers&lt;br&gt;retries ×5 → dead-letter, reclaims crashed work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-web-api" value="HTTP (proxied)&lt;br&gt;poll 2s / 1s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-k6-api" value="POST /api/purchase" style="entryX=0.25;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="k6" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-redis" value="EVALSHA gate&lt;br&gt;HGETALL sale · HGET status" style="exitX=1;exitY=0.227;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-pg" value="status fallback&lt;br&gt;migrate + rebuild on start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-stream-worker" value="XREADGROUP / XAUTOCLAIM&lt;br&gt;HSET CONFIRMED + XACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1" source="redis" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-worker-pg" value="INSERT …&lt;br&gt;ON CONFLICT DO NOTHING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cli-pg" value="replace sale" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="cli" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cli-redis" value="reset keys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="cli" target="redis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="620" />
              <mxPoint x="1080" y="620" />
              <mxPoint x="1080" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="purchase-flow" name="Purchase flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Buy → queue → worker → status&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines: centres at x = 110, 310, 510, 710, 910 -->
        <mxCell id="ll-browser" value="Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="120" height="780" as="geometry" />
        </mxCell>
        <mxCell id="ll-api" value="API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="120" height="780" as="geometry" />
        </mxCell>
        <mxCell id="ll-redis" value="Redis" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=40;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="70" width="120" height="780" as="geometry" />
        </mxCell>
        <mxCell id="ll-worker" value="Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="120" height="780" as="geometry" />
        </mxCell>
        <mxCell id="ll-pg" value="Postgres" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="70" width="120" height="780" as="geometry" />
        </mxCell>

        <!-- 1. Buy -->
        <mxCell id="m1" value="1. POST /api/purchase { userId }" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="150" as="sourcePoint" />
            <mxPoint x="310" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. normalise id, EVALSHA attempt-purchase" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="190" as="sourcePoint" />
            <mxPoint x="510" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n-gate" value="&lt;b&gt;Atomic Lua step&lt;/b&gt;&lt;br&gt;in window? (Redis TIME)&lt;br&gt;already bought? (HEXISTS)&lt;br&gt;stock &amp;gt; 0?&lt;br&gt;→ DECR stock&lt;br&gt;→ HSET user PENDING&lt;br&gt;→ XADD purchase-stream" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;spacingLeft=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="530" y="180" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. ACCEPTED | ALREADY_PURCHASED | SOLD_OUT | SALE_NOT_ACTIVE" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="320" as="sourcePoint" />
            <mxPoint x="310" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. 202 PENDING (or 409 / 410 / 403)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="350" as="sourcePoint" />
            <mxPoint x="110" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Async persistence -->
        <mxCell id="m5" value="5. XREADGROUP (blocks up to 2s)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="400" as="sourcePoint" />
            <mxPoint x="510" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. INSERT … ON CONFLICT DO NOTHING" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="440" as="sourcePoint" />
            <mxPoint x="910" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. MULTI: HSET user CONFIRMED + XACK" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="480" as="sourcePoint" />
            <mxPoint x="510" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n-fail" value="&lt;b&gt;If the insert fails 5×&lt;/b&gt; → dead-letter.lua:&lt;br&gt;HSET FAILED, INCR stock,&lt;br&gt;XADD dead-letter, XACK (atomic)&lt;br&gt;&lt;b&gt;If the worker crashes&lt;/b&gt; → another&lt;br&gt;worker XAUTOCLAIMs after 30s" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="730" y="500" width="230" height="95" as="geometry" />
        </mxCell>

        <!-- Status polling -->
        <mxCell id="m8" value="8. GET /api/purchase/:userId (every 1s while PENDING)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="640" as="sourcePoint" />
            <mxPoint x="310" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. HGET purchases userId" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="680" as="sourcePoint" />
            <mxPoint x="510" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9b" value="miss → SELECT … WHERE user_id" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;dashPattern=1 3;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="720" as="sourcePoint" />
            <mxPoint x="910" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. 200 CONFIRMED (or PENDING / FAILED / 404 NOT_FOUND)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="770" as="sourcePoint" />
            <mxPoint x="110" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
